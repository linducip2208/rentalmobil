APP_NAME=RentalMobil
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.test
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database utama wajib MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentalmobil
DB_USERNAME=rentalmobil
DB_PASSWORD=
# Test suite wajib memakai database MySQL terpisah.
DB_TEST_DATABASE=rentalmobil_testing

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@domain-anda.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pengaturan bisnis rental — bukan kredensial provider.
RENTAL_COMPANY_NAME="PT RentalMobil Indonesia"
RENTAL_TAX_RATE=0.11
RENTAL_CURRENCY=IDR
RENTAL_CURRENCY_SYMBOL=Rp
RENTAL_OVERDUE_THRESHOLD_HOURS=24
RENTAL_MISSING_THRESHOLD_HOURS=72
RENTAL_DRIVER_DAILY_COST=150000
RENTAL_INVOICE_DUE_DAYS=7
RENTAL_KM_LIMIT_MONTHLY=4000
RENTAL_KM_OVERAGE_RATE=2000
GPS_OFFLINE_THRESHOLD_MINUTES=15
GPS_LOG_RETENTION_DAYS=180

PORTAL_ENABLED=true
PORTAL_PREFIX=portal

# Semua provider GPS, pembayaran, notifikasi, storage, dan AI dikonfigurasi
# melalui menu Integrasi di admin. API key terenkripsi disimpan di database.

INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

SCHEDULER_OVERDUE_CHECK=true
SCHEDULER_REMINDER_CHECK=true
SCHEDULER_BACKUP_ENABLED=false
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30
