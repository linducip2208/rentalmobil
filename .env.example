APP_NAME=RentalMobil
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rentalmobil
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@rentalmobil.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Rental Settings ────────────────────────────────────────────
RENTAL_COMPANY_NAME="PT RentalMobil Indonesia"
RENTAL_TAX_RATE=0.11
RENTAL_CURRENCY=IDR
RENTAL_CURRENCY_SYMBOL=Rp
RENTAL_OVERDUE_THRESHOLD_HOURS=24
RENTAL_MISSING_THRESHOLD_HOURS=72
RENTAL_DRIVER_DAILY_COST=150000
RENTAL_INVOICE_DUE_DAYS=7
RENTAL_KM_LIMIT_MONTHLY=4000
RENTAL_KM_OVERAGE_RATE=2000

# ─── Portal Settings ────────────────────────────────────────────
PORTAL_ENABLED=true
PORTAL_PREFIX=portal

# ─── WhatsApp Provider (Dynamic — configure in admin panel) ─────
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_ID=

# ─── GPS Provider (Dynamic — configure in admin panel) ──────────
GPS_API_URL=
GPS_API_KEY=
GPS_DEVICE_GROUP=

# ─── SMS Provider (Dynamic — configure in admin panel) ──────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# ─── Mail Provider (Dynamic — configure in admin panel) ─────────
MAIL_PROVIDER_API_URL=
MAIL_PROVIDER_API_KEY=

# ─── Payment Gateway (Dynamic — configure in admin panel) ───────
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_CLIENT_KEY=
PAYMENT_IS_SANDBOX=true

# ─── AI / LLM Provider (Dynamic — configure in admin panel) ────
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── IndexNow ───────────────────────────────────────────────────
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# ─── Queue Connection ───────────────────────────────────────────
QUEUE_CONNECTION=database
# Options: sync, database, redis, sqs

# ─── Scheduler ──────────────────────────────────────────────────
SCHEDULER_OVERDUE_CHECK=true
SCHEDULER_REMINDER_CHECK=true
SCHEDULER_BACKUP_ENABLED=false
SCHEDULER_BACKUP_PATH=storage/app/backups

# ─── Backup Database ────────────────────────────────────────────
BACKUP_DISK=local
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30

# ─── Storage ────────────────────────────────────────────────────
FILESYSTEM_DISK=local
MEDIA_DISK=local
